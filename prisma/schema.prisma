generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
  DOCTOR
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @map("user_id") @db.ObjectId
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique @map("session_token") @db.String
  userId       String   @map("user_id") @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String    @unique @db.String
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String    @db.String
  phone         String?   @db.String
  role            UserRole  @default(USER)
  token           String?   @db.String
  isVerified      Boolean   @default(false)
  plan            String?   @db.String
  onboardingPage  String?   @db.String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  doctorProfile DoctorProfile?

  @@map("users")
}

model DoctorProfile {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  userId        String  @unique @db.ObjectId
  trackingNumber String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String
  middleName          String?
  dateOfBirth         DateTime?
  gender              String
  page                String?

  profilePicture      String?
  bio                 String?
  medicalLicense      String?
  medicalLicenseExpiry DateTime?
  yearsOfExperience   Int?
  email               String?
  phone               String?

  primarySpecialization String?
  otherSpecialties      String[] @default([])

  hospitalName            String?
  hospitalAddress         String?
  hospitalContactNumber   String?
  hospitalEmailAddress    String?
  hospitalWebsite         String?
  hoursOfOperation        String?
  servicesOffered         String[] @default([])
  insuranceAccepted       String?
  languagesSpoken         String[] @default([])

  educationHistory        String?
  publishedWork           String?
  accomplishments         String[] @default([])
  additionalDocuments     String[] @default([])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("doctor_profiles")
}
